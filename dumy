/* HERO */

.hero {
    min-height: 260px;
    padding: 15px 5% 25px;
    color: white;

    background:
    linear-gradient(90deg, rgba(0,25,20,.9), rgba(0,0,0,.2)),
    url("images/emergency-banner.jpg");

    background-size: cover;
    background-position: center;
}



.hero-content {
    display: flex;
    align-items: center;
    gap: 20px;
}

.hero-icon {
    width: 85px;
    height: 85px;
    border: 3px solid white;
    border-radius: 15px;
    display: grid;
    place-items: center;
    font-size: 45px;
    background: #e52d32;
}

.hero h1 {
    font-size: clamp(25px, 4vw, 42px);
}

.hero h1 span {
    color: #75e65d;
}

.hero p {
    font-size: 15px;
}

.hero-search {
    margin-top: 22px;
    width: min(450px, 100%);
    background: white;
    padding: 6px 10px;
    display: flex;
    align-items: center;
    border-radius: 10px;
    gap: 10px;
    color: #15985b;
}

.hero-search input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    padding: 10px 0;
}

.hero-search button {
    background: #15985b;
    border: none;
    padding: 12px 25px;
    border-radius: 10px;
    color: white;
    cursor: pointer;
}


/* FILTER */

.filter-section {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 5%;
    flex-wrap: wrap;
    background: white;
}

.filter-title {
    font-weight: 600;
    margin-right: 10px;
}

.filter-btn {
    border: 1px solid #ddd;
    background: white;
    padding: 9px 17px;
    border-radius: 30px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
}

.filter-btn.active,
.filter-btn:hover {
    background: #087d43;
    color: white;
}


/* SERVICES */

.services-section {
    padding: 30px 4%;
}

.section-heading {
    margin-bottom: 20px;
    border-left: 5px solid #15985b;
    padding-left: 15px;
}

.section-heading h2 {
    font-size: 25px;
}

.section-heading h2 span {
    color: #15985b;
}

.section-heading p {
    color: #555;
    font-size: 13px;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.service-card {
    background: white;
    border-radius: 13px;
    overflow: hidden;
    box-shadow: 0 3px 12px #00000018;
    transition: .3s;
}

.service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px #00000020;
}

.card-image {
    height: 180px;
    position: relative;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.card-image > i {
    position: absolute;
    top: 12px;
    right: 15px;
    font-size: 22px;
    color: white;
    cursor: pointer;
}

.card-content {
    padding: 15px;
}

.card-content h3 {
    font-size: 17px;
}

.card-content p {
    color: #555;
    font-size: 12px;
    margin: 7px 0;
    min-height: 38px;
}

.rating {
    color: #138447;
    font-size: 12px;
    margin-bottom: 12px;
}

.card-buttons {
    display: flex;
    gap: 10px;
}

.card-buttons a {
    flex: 1;
    text-align: center;
    padding: 9px;
    border-radius: 7px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
}

.call-btn {
    background: #e4f6e8;
    color: #087d43;
}

.map-btn {
    background: #087d43;
    color: white;
}

#noResults {
    text-align: center;
    padding: 30px;
}


/* EMERGENCY NUMBERS */

.emergency-section {
    padding: 35px 4%;
    background: #eaf6ed;
}

.emergency-heading {
    margin-bottom: 20px;
}

.emergency-heading h2 {
    font-size: 24px;
}

.emergency-heading p {
    color: #555;
    font-size: 13px;
}

.number-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.number-card {
    background: white;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 3px 10px #00000010;
}

.number-card > i {
    font-size: 30px;
    color: #15985b;
}

.number-card h3 {
    font-size: 13px;
}

.number-card h2 {
    color: #087d43;
    font-size: 24px;
}


/* LOCATION */

.location-section {
    padding: 30px 4%;
}

.location-content {
    background: #dff5e4;
    border-radius: 15px;
    padding: 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.location-content i {
    color: #087d43;
    margin-right: 8px;
}

.location-content p {
    font-size: 13px;
    margin-top: 5px;
}

.location-content a {
    background: #087d43;
    color: white;
    padding: 12px 25px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
}


/* FOOTER */

footer {
    background: #002d22;
    color: white;
    padding: 35px 5% 10px;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 30px;
}

.footer-content p {
    font-size: 12px;
    margin-top: 10px;
    color: #ddd;
}

.footer-content h3 {
    margin-bottom: 10px;
}

.footer-content a {
    display: block;
    color: #ddd;
    text-decoration: none;
    font-size: 13px;
    margin: 7px 0;
}

.copyright {
    text-align: center;
    border-top: 1px solid #ffffff30;
    padding-top: 15px;
    margin-top: 25px;
    font-size: 12px;
}


/* RESPONSIVE */

@media(max-width: 1000px) {

    .navbar nav {
        display: none;
    }

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .number-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media(max-width: 600px) {

    .navbar {
        padding: 12px 4%;
    }

    .logo {
        font-size: 19px;
    }

    .nav-search {
        display: none;
    }

    .hero {
        min-height: 250px;
        padding: 15px 4%;
    }

    .hero-content {
        gap: 12px;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        font-size: 30px;
        flex-shrink: 0;
    }

    .hero p {
        font-size: 12px;
    }

    .filter-section {
        gap: 8px;
        padding: 15px 4%;
    }

    .filter-btn {
        padding: 8px 12px;
    }

    .service-grid {
        grid-template-columns: 1fr;
    }

    .card-image {
        height: 200px;
    }

    .number-grid {
        grid-template-columns: 1fr;
    }

    .location-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-content {
        grid-template-columns: 1fr;
    }

}